import { randomUUID } from 'node:crypto';
import { Module } from '@nestjs/common';
import { ConfigModule } from '@nestjs/config';
import { LoggerModule } from 'nestjs-pino';
import { envSchema } from './config/env.schema';
import { PrismaModule } from './prisma/prisma.module';
import { FinancialModule } from './financial/financial.module';
import { ApiContractsModule } from './api/api-contracts.module';

@Module({
  imports: [
    ConfigModule.forRoot({ isGlobal: true, cache: true, validate: (config) => envSchema.parse(config) }),
    LoggerModule.forRoot({
      pinoHttp: {
        level: process.env.LOG_LEVEL ?? 'info',
        genReqId: (request, response) => {
          const incoming = request.headers['x-correlation-id'];
          const correlationId = typeof incoming === 'string' && /^[a-zA-Z0-9._-]{1,128}$/.test(incoming)
            ? incoming
            : randomUUID();
          response.setHeader('x-correlation-id', correlationId);
          return correlationId;
        },
        customProps: (request) => ({ correlationId: request.id }),
        redact: { paths: ['req.headers.authorization', 'req.headers.cookie'], censor: '[REDACTED]' },
        serializers: {
          req: (request) => ({ method: request.method, url: request.url, id: request.id }),
          res: (response) => ({ statusCode: response.statusCode }),
        },
      },
    }),
    PrismaModule,
    FinancialModule,
    ApiContractsModule,
  ],
})
export class AppModule {}
