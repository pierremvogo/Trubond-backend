model Dispute {
  id                  String             @id @default(uuid()) @db.Uuid
  testId              String             @map("test_id") @db.Uuid
  ledgerTransactionId String?            @map("ledger_transaction_id") @db.Uuid
  openedBy            String             @map("opened_by") @db.VarChar(128)
