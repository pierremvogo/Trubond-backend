  payout         Payout?               @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  refund         Refund?               @relation(fields: [refundId], references: [id], onDelete: Restrict)
  reverses       LedgerTransaction?    @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversals      LedgerTransaction[]   @relation("LedgerReversal")
  entries        LedgerEntry[]
  disputes       Dispute[]
