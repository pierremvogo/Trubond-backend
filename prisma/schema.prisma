// =============================================================================
// Schéma Prisma corrigé
// Marqueurs : [CHANGED] = modifié, [NEW] = ajouté, [REMOVED] = supprimé
// Prisma 7+ : l'URL de connexion se déclare dans prisma.config.ts.
// Prisma <= 6 : ajouter  url = env("DATABASE_URL")  dans le bloc datasource.
// Les contraintes non supportées par Prisma sont dans post_constraints.sql
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum AuthFactorType {
  SMS_OTP
  TOTP
  PASSKEY
}

enum AuthFactorStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  PASSWORD_RESET
  ACCOUNT_DELETE
  SIGN_IN
  SIGN_UP
  PHONE_CHANGE
  INVITATION_ACCEPTANCE
  PAYOUT_CONFIRMATION
}

enum OtpStatus {
  CREATED
  SENT
  VERIFIED
  EXPIRED
  LOCKED
  FAILED
}

enum Platform {
  ANDROID
  IOS
  WEB
  OTHER
}

enum ConsentType {
  TERMS
  PRIVACY
  TEST_PARTICIPATION
  PAYMENT_FEES
  DATA_PROCESSING
  MARKETING
}

enum DataRequestType {
  ACCESS
  RECTIFICATION
  EXPORT
  ERASURE
}

enum DataRequestStatus {
  RECEIVED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum TestStatus {
  DRAFT
  PAYMENT_PENDING
  FUNDED
  SENT
  SUCCESS
  FAILURE
  EXPIRED
  PAYOUT_PENDING
  REFUND_PENDING
  COMPLETED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum TestActorType {
  USER
  ADMIN
  SYSTEM
  WORKER
}

enum InvitationChannel {
  SMS
  WHATSAPP
  EMAIL
  OTHER
}

enum InvitationStatus {
  CREATED
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPENED
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PaymentMethodType {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REQUIRES_REVIEW
}

enum PayoutStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_REVIEW
}

enum RefundStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_REVIEW
}

// [CHANGED] L'ancien enum "Provider" est scindé en trois enums métier.

// Prestataires de paiement (cahier des charges §5)
enum PaymentProvider {
  ORANGE_MONEY
  MTN_MOMO
  FLUTTERWAVE
  STRIPE
  PAYSTACK
  LYGOS
  MANUAL
}

// Prestataires SMS / email / push (cahier des charges §5)
enum MessagingProvider {
  TWILIO
  FCM
  ONESIGNAL
  OTHER
}

// Prestataires de vérification d'identité
enum KycProvider {
  MANUAL
  OTHER
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerNormalSide {
  DEBIT
  CREDIT
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  PAYMENT_CAPTURE
  ESCROW_FUNDING
  SERVICE_FEE_RECOGNITION
  PAYOUT_RESERVATION
  PAYOUT_SETTLEMENT
  REFUND_RESERVATION
  REFUND_SETTLEMENT
  PSP_FEE
  REVERSAL
  ADJUSTMENT
  REFERRAL_REWARD
  RECONCILIATION
}

enum ReconciliationStatus {
  CREATED
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationBreakStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED
}

enum FeeOperationType {
  COLLECTION
  PAYOUT
  REFUND
  SERVICE // [NEW] frais de service de la plateforme (ex. 2 500 FCFA par test)
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum RiskCaseStatus {
  OPEN
  REVIEWING
  ACTION_REQUIRED
  RESOLVED
  DISMISSED
}

enum RiskSubjectType {
  USER
  TEST
  PAYMENT
  PAYOUT
  REFUND
  DEVICE
  PHONE
}

enum BlocklistSubjectType {
  PHONE_HMAC
  DEVICE_HASH
  USER_ID
  TRANSACTION_REF
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  WAITING_USER
  WAITING_PROVIDER
  RESOLVED
  REJECTED
  CLOSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum ReferralStatus {
  ATTRIBUTED
  QUALIFIED
  REJECTED
  EXPIRED
}

enum ReferralRewardStatus {
  PENDING
  APPROVED
  ISSUED
  CANCELLED
}

// [NEW] Support client intégré (cahier des charges §6)
enum TicketStatus {
  OPEN
  PENDING_USER
  PENDING_INTERNAL
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketAuthorType {
  USER
  ADMIN
  SYSTEM
}

// ----------------------------------------------------------------------------
// UTILISATEURS & AUTH
// ----------------------------------------------------------------------------

model User {
  passwordHash String? @map("password_hash") @db.Text
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  id          String     @id @default(uuid()) @db.Uuid
  phoneHmac   String     @unique @map("phone_hmac") @db.VarChar(128)
  phoneEnc    String     @map("phone_enc") @db.Text
  countryCode String     @map("country_code") @db.Char(2)
  locale      String     @default("fr") @db.VarChar(12)
  status      UserStatus @default(ACTIVE)
  kycStatus   KycStatus  @default(NOT_STARTED) @map("kyc_status")
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authFactors             AuthFactor[]
  sessions                Session[]
  devices                 Device[]
  consents                Consent[]
  dataRequests            DataRequest[]
  kycProfile              KycProfile?
  tests                   Test[]                   @relation("TestInitiator")
  testsReceived           Test[]                   @relation("TestRecipient") // [NEW]
  notifications           NotificationLog[]
  notificationPreferences NotificationPreference[]
  riskCases               RiskCase[]
  referralCode            ReferralCode?
  referralsMade           Referral[]               @relation("Referrer")
  referralReceived        Referral?                @relation("ReferredUser")
  auditEvents             AuditLog[]               @relation("AuditUserActor")
  idempotencyKeys         IdempotencyKey[]
  exportJobs              ExportJob[]
  supportTickets          SupportTicket[] // [NEW]
  supportMessages         SupportMessage[] // [NEW]

  @@index([status, createdAt])
  @@index([countryCode, status])
  @@map("users")
}

model AuthFactor {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        AuthFactorType
  status      AuthFactorStatus @default(PENDING)
  secretEnc   String?          @map("secret_enc") @db.Text
  providerRef String?          @map("provider_ref") @db.VarChar(255)
  verifiedAt  DateTime?        @map("verified_at") @db.Timestamptz(6)
  lastUsedAt  DateTime?        @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, status])
  @@map("auth_factors")
}

model OtpChallenge {
  id            String             @id @default(uuid()) @db.Uuid
  recipientHmac String             @map("recipient_hmac") @db.VarChar(128)
  codeHash      String             @map("code_hash") @db.VarChar(255)
  purpose       OtpPurpose
  status        OtpStatus          @default(CREATED)
  provider      MessagingProvider? // [CHANGED] était Provider
  providerRef   String?            @map("provider_ref") @db.VarChar(255)
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5) @map("max_attempts")
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  verifiedAt    DateTime?          @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientHmac, purpose, createdAt])
  @@index([status, expiresAt])
  @@map("otp_challenges")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     Session?  @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces       Session[] @relation("SessionRotation")

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("sessions")
}

model Device {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  deviceHash   String             @map("device_hash") @db.VarChar(128)
  platform     Platform
  appVersion   String?            @map("app_version") @db.VarChar(40)
  pushToken    String?            @map("push_token") @db.VarChar(500) // [NEW]
  pushProvider MessagingProvider? @map("push_provider") // [NEW] FCM ou ONESIGNAL
  pushTokenAt  DateTime?          @map("push_token_at") @db.Timestamptz(6) // [NEW]
  lastSeenAt   DateTime?          @map("last_seen_at") @db.Timestamptz(6)
  riskFlag     Boolean            @default(false) @map("risk_flag")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([deviceHash])
  @@index([userId, lastSeenAt])
  @@map("devices")
}

model Consent {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  testId          String?     @map("test_id") @db.Uuid
  type            ConsentType
  documentVersion String      @map("document_version") @db.VarChar(80)
  locale          String      @db.VarChar(12)
  channel         String      @db.VarChar(40)
  accepted        Boolean
  evidenceHash    String?     @map("evidence_hash") @db.VarChar(128)
  acceptedAt      DateTime?   @map("accepted_at") @db.Timestamptz(6)
  withdrawnAt     DateTime?   @map("withdrawn_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  test            Test?       @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([userId, type, createdAt])
  @@index([testId, type, createdAt])
  @@map("consents")
}

model DataRequest {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  type         DataRequestType
  status       DataRequestStatus @default(RECEIVED)
  reason       String?           @db.VarChar(1000)
  dueAt        DateTime?         @map("due_at") @db.Timestamptz(6)
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(6)
  decisionNote String?           @map("decision_note") @db.VarChar(2000)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([userId, createdAt])
  @@map("data_requests")
}

model KycProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @unique @map("user_id") @db.Uuid
  provider    KycProvider? // [CHANGED] était Provider
  providerRef String?      @map("provider_ref") @db.VarChar(255)
  status      KycStatus    @default(NOT_STARTED)
  level       Int          @default(0)
  verifiedAt  DateTime?    @map("verified_at") @db.Timestamptz(6)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("kyc_profiles")
}

// ----------------------------------------------------------------------------
// TESTS
// ----------------------------------------------------------------------------

model Test {
  id                 String              @id @default(uuid()) @db.Uuid
  publicCode         String              @unique @map("public_code") @db.VarChar(64)
  initiatorId        String              @map("initiator_id") @db.Uuid
  // [NEW] Le testé devient un User après vérification OTP (INVITATION_ACCEPTANCE).
  // Permet de rattacher son consentement TEST_PARTICIPATION et son historique.
  recipientUserId    String?             @map("recipient_user_id") @db.Uuid
  recipientPhoneHmac String              @map("recipient_phone_hmac") @db.VarChar(128)
  recipientPhoneEnc  String?             @map("recipient_phone_enc") @db.Text // à purger après envoi de l'invitation
  // Numéro attendu comme bonne réponse. Seul le HMAC est conservé (minimisation, §3 du cahier).
  // [REMOVED] expectedPhoneEnc : inutile pour comparer answerHmac et expectedPhoneHmac.
  expectedPhoneHmac  String              @map("expected_phone_hmac") @db.VarChar(128)
  status             TestStatus          @default(DRAFT)
  currency           String              @db.Char(3)
  rewardAmount       BigInt              @map("reward_amount")
  serviceFeeAmount   BigInt              @map("service_fee_amount")
  totalAmount        BigInt              @map("total_amount")
  feeScheduleId      String?             @map("fee_schedule_id") @db.Uuid
  expiresAt          DateTime?           @map("expires_at") @db.Timestamptz(6)
  sentAt             DateTime?           @map("sent_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  version            Int                 @default(0)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  initiator          User                @relation("TestInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  recipient          User?               @relation("TestRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict) // [NEW]
  feeSchedule        FeeSchedule?        @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  attempt            TestAttempt?
  events             TestEvent[]
  invitations        Invitation[]
  consents           Consent[]
  payments           Payment[]
  payouts            Payout[]
  refunds            Refund[]
  ledgerTransactions LedgerTransaction[]
  invoices           Invoice[]
  riskCases          RiskCase[]
  disputes           Dispute[]
  referralRewards    ReferralReward[]
  supportTickets     SupportTicket[] // [NEW]

  @@index([initiatorId, createdAt])
  @@index([recipientUserId, createdAt]) // [NEW]
  @@index([status, expiresAt])
  @@index([recipientPhoneHmac, createdAt])
  @@index([status, updatedAt])
  @@map("tests")
}

model TestAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @unique @map("test_id") @db.Uuid
  answerHmac  String   @map("answer_hmac") @db.VarChar(128)
  isCorrect   Boolean  @map("is_correct")
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  source      String   @db.VarChar(40)
  test        Test     @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([testId, submittedAt])
  @@index([submittedAt])
  @@map("test_attempts")
}

model TestEvent {
  id            String        @id @default(uuid()) @db.Uuid
  testId        String        @map("test_id") @db.Uuid
  fromStatus    TestStatus?   @map("from_status")
  toStatus      TestStatus    @map("to_status")
  actorType     TestActorType @map("actor_type")
  actorId       String?       @map("actor_id") @db.VarChar(128)
  reason        String?       @db.VarChar(1000)
  source        String        @db.VarChar(80)
  correlationId String?       @map("correlation_id") @db.VarChar(128)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  test          Test          @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([testId, createdAt])
  @@index([correlationId])
  @@map("test_events")
}

model Invitation {
  id          String            @id @default(uuid()) @db.Uuid
  testId      String            @map("test_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.VarChar(128)
  channel     InvitationChannel
  status      InvitationStatus  @default(CREATED)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(6)
  sentAt      DateTime?         @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime?         @map("delivered_at") @db.Timestamptz(6)
  openedAt    DateTime?         @map("opened_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  providerRef String?           @map("provider_ref") @db.VarChar(255)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  test        Test              @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([testId, createdAt])
  @@index([status, expiresAt])
  @@map("invitations")
}

// ----------------------------------------------------------------------------
// PAIEMENTS, PAYOUTS, REMBOURSEMENTS
// ----------------------------------------------------------------------------

model Payment {
  id                   String                @id @default(uuid()) @db.Uuid
  testId               String                @map("test_id") @db.Uuid
  provider             PaymentProvider // [CHANGED]
  methodType           PaymentMethodType     @map("method_type")
  status               PaymentStatus         @default(CREATED)
  amount               BigInt
  currency             String                @db.Char(3)
  idempotencyKey       String                @map("idempotency_key") @db.VarChar(128)
  feeScheduleId        String?               @map("fee_schedule_id") @db.Uuid
  providerReference    String?               @map("provider_reference") @db.VarChar(255)
  failureCode          String?               @map("failure_code") @db.VarChar(100)
  failureMessage       String?               @map("failure_message") @db.VarChar(500)
  confirmedAt          DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  test                 Test                  @relation(fields: [testId], references: [id], onDelete: Restrict)
  feeSchedule          FeeSchedule?          @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  webhooks             WebhookEvent[]
  ledgerTransactions   LedgerTransaction[]
  reconciliationBreaks ReconciliationBreak[]
  refunds              Refund[]

  @@unique([provider, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([testId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model Payout {
  id                   String                @id @default(uuid()) @db.Uuid
  testId               String                @map("test_id") @db.Uuid
  // [NEW] Numéro de tentative : un échec de transfert doit permettre un nouvel essai.
  attempt              Int                   @default(1)
  provider             PaymentProvider // [CHANGED]
  methodType           PaymentMethodType     @map("method_type") // [NEW]
  operator             String?               @db.VarChar(40) // [NEW] ex. ORANGE_MONEY, MTN_MOMO
  status               PayoutStatus          @default(CREATED)
  amountGross          BigInt                @map("amount_gross")
  amountNet            BigInt                @map("amount_net")
  providerFeeAmount    BigInt                @default(0) @map("provider_fee_amount")
  currency             String                @db.Char(3)
  destinationEnc       String                @map("destination_enc") @db.Text
  destinationHmac      String                @map("destination_hmac") @db.VarChar(128)
  idempotencyKey       String                @map("idempotency_key") @db.VarChar(128)
  feeScheduleId        String?               @map("fee_schedule_id") @db.Uuid
  providerReference    String?               @map("provider_reference") @db.VarChar(255)
  failureCode          String?               @map("failure_code") @db.VarChar(100)
  confirmedAt          DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  test                 Test                  @relation(fields: [testId], references: [id], onDelete: Restrict)
  feeSchedule          FeeSchedule?          @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  webhooks             WebhookEvent[]
  ledgerTransactions   LedgerTransaction[]
  reconciliationBreaks ReconciliationBreak[] // [NEW]

  @@unique([provider, idempotencyKey])
  @@unique([provider, providerReference])
  // [CHANGED] était @@unique([testId]) qui bloquait tout nouvel essai.
  // L'unicité d'un payout ACTIF par test est garantie par post_constraints.sql.
  @@unique([testId, attempt])
  @@index([testId, status])
  @@index([status, createdAt])
  @@map("payouts")
}

model Refund {
  id                   String                @id @default(uuid()) @db.Uuid
  testId               String                @map("test_id") @db.Uuid
  paymentId            String?               @map("payment_id") @db.Uuid
  attempt              Int                   @default(1) // [NEW]
  provider             PaymentProvider // [CHANGED]
  methodType           PaymentMethodType?    @map("method_type") // [NEW]
  operator             String?               @db.VarChar(40) // [NEW]
  status               RefundStatus          @default(CREATED)
  amount               BigInt
  currency             String                @db.Char(3)
  reason               String                @db.VarChar(500)
  // [NEW] Mobile money : un remboursement est un NOUVEAU transfert vers l'initiateur,
  // il faut donc une destination. Nullable pour les remboursements carte (via Payment).
  destinationEnc       String?               @map("destination_enc") @db.Text
  destinationHmac      String?               @map("destination_hmac") @db.VarChar(128)
  idempotencyKey       String                @map("idempotency_key") @db.VarChar(128)
  feeScheduleId        String?               @map("fee_schedule_id") @db.Uuid
  providerReference    String?               @map("provider_reference") @db.VarChar(255)
  requestedBy          String?               @map("requested_by") @db.VarChar(128)
  confirmedAt          DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
