  scope        String            @db.VarChar(120)
  key          String            @db.VarChar(180)
  actorType    String            @map("actor_type") @db.VarChar(40)
  actorRef     String            @map("actor_ref") @db.VarChar(128)
  userId       String?           @map("user_id") @db.Uuid
