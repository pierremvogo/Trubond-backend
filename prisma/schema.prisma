  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminApproval {
  id           String         @id @default(uuid()) @db.Uuid
  action       String         @db.VarChar(120)
  targetType   String         @map("target_type") @db.VarChar(80)
  targetId     String         @map("target_id") @db.VarChar(128)
  requesterId  String         @map("requester_id") @db.Uuid
  approverId   String?        @map("approver_id") @db.Uuid
  amount       BigInt?
  currency     String?        @db.Char(3)
  reason       String         @db.VarChar(1000)
  status       ApprovalStatus @default(PENDING)
  decisionNote String?        @map("decision_note") @db.VarChar(1000)
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  requester    AdminUser      @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver     AdminUser?     @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("admin_approvals")
}

model ExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  // [CHANGED] userId devient optionnel (exports globaux de tests/logs, §6 du cahier)
  // et passe en Restrict, comme le reste du schéma.
  userId        String?      @map("user_id") @db.Uuid
  filters       Json
  format        String       @db.VarChar(20)
  status        ExportStatus @default(QUEUED)
  objectKey     String?      @map("object_key") @db.VarChar(500)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)
  errorMessage  String?      @map("error_message") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestedBy   AdminUser    @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([userId])
  @@map("export_jobs")
}

// ----------------------------------------------------------------------------
// CONFIGURATION
// ----------------------------------------------------------------------------

model Country {
  code            String   @id @db.Char(2)
  name            String   @db.VarChar(100)
  defaultCurrency String   @map("default_currency") @db.Char(3)
  // [NEW] Récompense minimale par pays (ex. 20 000 XAF pour le Cameroun).
  // Validée dans le service, car le minimum dépend du pays (pas exprimable en CHECK).
  minRewardAmount BigInt   @default(0) @map("min_reward_amount")
  enabled         Boolean  @default(false)
  config          Json?
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("countries")
}

model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(120)
  enabled        Boolean  @default(false)
  countryCode    String?  @map("country_code") @db.Char(2)
  rolloutPercent Int      @default(0) @map("rollout_percent")
  config         Json?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([countryCode, enabled])
  @@map("feature_flags")
}

// ----------------------------------------------------------------------------
// PARRAINAGE
// ----------------------------------------------------------------------------

model ReferralCode {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @unique @map("user_id") @db.Uuid
  code         String     @unique @db.VarChar(40)
  campaignKey  String?    @map("campaign_key") @db.VarChar(100)
  termsVersion String?    @map("terms_version") @db.VarChar(80)
  active       Boolean    @default(true)
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  referrals    Referral[]

  @@index([active, expiresAt])
  @@map("referral_codes")
}

model Referral {
  id             String           @id @default(uuid()) @db.Uuid
  referralCodeId String           @map("referral_code_id") @db.Uuid
  referrerId     String           @map("referrer_id") @db.Uuid
  referredUserId String           @unique @map("referred_user_id") @db.Uuid
  status         ReferralStatus   @default(ATTRIBUTED)
  attributedAt   DateTime         @default(now()) @map("attributed_at") @db.Timestamptz(6)
  qualifiedAt    DateTime?        @map("qualified_at") @db.Timestamptz(6)
  evidence       Json?
  referralCode   ReferralCode     @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referrer       User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser   User             @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Restrict)
  rewards        ReferralReward[]

  @@unique([referrerId, referredUserId])
  @@index([referrerId, status, attributedAt])
  @@index([status, qualifiedAt])
  @@map("referrals")
}

model ReferralReward {
  id                  String               @id @default(uuid()) @db.Uuid
  referralId          String               @map("referral_id") @db.Uuid
  testId              String?              @map("test_id") @db.Uuid
  amount              BigInt
  currency            String               @db.Char(3)
  status              ReferralRewardStatus @default(PENDING)
  ruleVersion         String               @map("rule_version") @db.VarChar(80)
  ledgerTransactionId String?              @unique @map("ledger_transaction_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  issuedAt            DateTime?            @map("issued_at") @db.Timestamptz(6)
  referral            Referral             @relation(fields: [referralId], references: [id], onDelete: Restrict)
  test                Test?                @relation(fields: [testId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction?   @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@unique([referralId, ruleVersion])
  @@index([status, createdAt])
  @@map("referral_rewards")
}
