  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([currency, createdAt])
  @@map("ledger_entries")
}

model ReconciliationRun {
  id          String                @id @default(uuid()) @db.Uuid
