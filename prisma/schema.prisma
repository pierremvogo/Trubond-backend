}

model LedgerTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(180)
  type           LedgerTransactionType
  currency       String                @db.Char(3)
  description    String?               @db.VarChar(500)
  testId         String?               @map("test_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  payoutId       String?               @map("payout_id") @db.Uuid
  refundId       String?               @map("refund_id") @db.Uuid
  reversesId     String?               @map("reverses_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
